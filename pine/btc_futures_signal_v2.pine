//@version=6
// =====================================================
// BTC Futures BUY/SELL Webhook Alert v2.1.1
//
// v2.1.1 (May 14, 2026): Tag every payload with "signal_type":"swing" so the
// webhook can route this indicator under the "swing" trading plan. The
// upcoming v3 (15m day-trade indicator) will tag itself "intraday". Admin
// controls which plans are active via Settings → Active Trading Plans.
//
// v2.1 (May 14, 2026): Added Daily EMA200 trend filter — makes the system
// regime-adaptive instead of forcing the admin to flip Enable LONG on/off
// manually as BTC switches between bull and bear cycles. Strategy v1.3
// backtest with this filter on lifted PF from 0.819 to 1.31.
//
// What the Daily filter does:
//   - LONG fires only when close > Daily EMA200  (we're in an uptrend)
//   - SHORT fires only when close < Daily EMA200 (we're in a downtrend)
//   - Eliminates counter-trend trades, which were the main loss source
//
// Default OFF for backwards compatibility — turn on in the Inputs tab,
// then recreate the TradingView alert so it uses the new code (TV caches
// the script source at alert creation time).
// =====================================================
indicator("BTC Futures BUY/SELL Webhook Alert v2.1", overlay=true, max_labels_count=500)

// =====================================================
// === Inputs
// =====================================================
grpCore   = "Core EMAs / RSI / ATR"
fastEmaLength  = input.int(21,  "Fast EMA",  minval=1, group=grpCore)
slowEmaLength  = input.int(55,  "Slow EMA",  minval=1, group=grpCore)
trendEmaLength = input.int(200, "Trend EMA", minval=1, group=grpCore)
rsiLength      = input.int(14,  "RSI Length", minval=1, group=grpCore)
rsiLongMin     = input.float(52.0, "RSI min for LONG",  minval=0, maxval=100, group=grpCore)
rsiLongMax     = input.float(75.0, "RSI max for LONG (avoid overbought)", minval=0, maxval=100, group=grpCore)
rsiShortMax    = input.float(48.0, "RSI max for SHORT", minval=0, maxval=100, group=grpCore)
rsiShortMin    = input.float(25.0, "RSI min for SHORT (avoid oversold)",  minval=0, maxval=100, group=grpCore)
atrLength      = input.int(14,  "ATR Length", minval=1, group=grpCore)

grpRisk   = "Risk Management"
atrStopMult    = input.float(1.8, "Stop-loss ATR multiplier", minval=0.1, step=0.1, group=grpRisk)
tp1Mult        = input.float(1.0, "TP1 reward (R multiple)",  minval=0.1, step=0.1, group=grpRisk)
tp2Mult        = input.float(2.0, "TP2 reward (R multiple)",  minval=0.1, step=0.1, group=grpRisk)
entryZoneAtrMult = input.float(0.15, "Entry zone half-width (ATR mult)", minval=0.0, step=0.05, group=grpRisk)

grpFilter = "Quality Filters"
adxLength      = input.int(14,   "ADX length", minval=1, group=grpFilter)
adxMin         = input.float(17.0, "ADX minimum (trend strength)", minval=0, group=grpFilter)
trendSlopeBars = input.int(10,   "Trend EMA slope lookback bars",  minval=1, group=grpFilter)
volMaLength    = input.int(20,   "Volume MA length", minval=1, group=grpFilter)
volMult        = input.float(1.0, "Volume must exceed MA × this",  minval=0.0, step=0.1, group=grpFilter)
atrPctMin      = input.float(0.25, "Minimum ATR % of price (kills dead market)", minval=0, step=0.05, group=grpFilter)
useHtfFilter   = input.bool(false, "Require 4H EMA50 trend alignment", group=grpFilter)
htfTimeframe   = input.string("240", "Higher timeframe", options=["120","240","360","720","D"], group=grpFilter)
htfEmaLen      = input.int(50,   "HTF EMA length", minval=1, group=grpFilter)
cooldownBars   = input.int(3,    "Cooldown bars after a signal", minval=0, group=grpFilter)

// v2.1 — Daily trend filter (regime gate). When ON: LONG only when price is
// above the daily EMA, SHORT only when below. Removes counter-trend trades
// without having to flip Enable LONG / Enable SHORT manually.
useDailyTrend     = input.bool(false, "Require Daily EMA trend alignment (v2.1)", group=grpFilter, tooltip="LONG only when price > Daily EMA, SHORT only when below. Default OFF for backwards compat — turn on to match the v1.3+Daily backtest profile.")
dailyEmaLength    = input.int(200,    "Daily EMA length (v2.1)", minval=10, group=grpFilter)

// Session / time-of-day filter — block hours with poor historical win rate
// (Asia midday & US/London open whipsaw). Hours are evaluated in Asia/Bangkok TZ.
useTimeFilter  = input.bool(true,  "Block low win-rate hours (Asia/Bangkok)", group=grpFilter)
blockHours     = input.string("13,14,16,17,20", "Blocked hours (comma list, 0-23 BKK)", group=grpFilter)

grpRun    = "Execution"
useConfirmedBar = input.bool(true,  "Alert only after candle close", group=grpRun)
enableLong      = input.bool(true,  "Enable LONG (BUY) alerts",  group=grpRun)
enableShort     = input.bool(true,  "Enable SHORT (SELL) alerts", group=grpRun)
enableNoTradeAlert = input.bool(true, "Send NO_TRADE update every candle close", group=grpRun, tooltip="Sends a heartbeat alert each hour explaining why the bot stayed flat. Disable to silence.")
testAlert       = input.bool(false, "Send TEST alert every candle close", group=grpRun)

grpHook   = "Webhook"
secret    = input.string("btc_ai_secret_2026_x7k29pQ", "Webhook secret",   group=grpHook)
botName   = input.string("btc-futures-signal", "Bot/source name", group=grpHook)
priceDecimals = input.int(2, "Price decimals in JSON", minval=0, maxval=8, group=grpHook)

grpView  = "Visuals"
showStatusTable = input.bool(true,  "Show live status table",        group=grpView)
showLevels      = input.bool(true,  "Draw SL/TP lines after signals", group=grpView)
levelsBars      = input.int(50, "Lines extend N bars", minval=10, maxval=500, group=grpView)
shadeBlocked    = input.bool(true,  "Shade blocked-hour candles",    group=grpView)

// =====================================================
// === Calculations
// =====================================================
fastEma  = ta.ema(close, fastEmaLength)
slowEma  = ta.ema(close, slowEmaLength)
trendEma = ta.ema(close, trendEmaLength)
rsi      = ta.rsi(close, rsiLength)
atr      = ta.atr(atrLength)

[diPlus, diMinus, adx] = ta.dmi(adxLength, adxLength)
volMa = ta.sma(volume, volMaLength)

// HTF trend (no repaint: lookahead_off + use confirmed HTF close)
htfEma = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)

// v2.1 — Daily EMA200 for regime detection (no repaint either)
dailyEma = request.security(syminfo.tickerid, "D", ta.ema(close, dailyEmaLength), lookahead=barmerge.lookahead_off)
dailyTrendUp   = not na(dailyEma) and close > dailyEma
dailyTrendDown = not na(dailyEma) and close < dailyEma

// Filters
trendUp     = trendEma > trendEma[trendSlopeBars]
trendDown   = trendEma < trendEma[trendSlopeBars]
trendStrong = adx >= adxMin
volOk       = volume > volMa * volMult
atrOk       = (atr / close * 100.0) >= atrPctMin
htfUp       = not useHtfFilter or close > htfEma
htfDown     = not useHtfFilter or close < htfEma

// v2.1 — Daily regime gate: when off this is a no-op (true); when on
// it forces LONG to require dailyTrendUp and SHORT to require dailyTrendDown.
dailyOkLong  = not useDailyTrend or dailyTrendUp
dailyOkShort = not useDailyTrend or dailyTrendDown

barReady = useConfirmedBar ? barstate.isconfirmed : true

// Time-of-day gate — current bar's hour in Asia/Bangkok TZ vs blocked list
currentHourBkk = hour(time, "Asia/Bangkok")
isBlockedHour = str.contains("," + blockHours + ",", "," + str.tostring(currentHourBkk) + ",")
timeOk = not useTimeFilter or not isBlockedHour

// Cooldown
var int lastSignalBar = na
canSignal = na(lastSignalBar) or (bar_index - lastSignalBar) >= cooldownBars

// Raw triggers
rawLong  = ta.crossover(fastEma, slowEma)  and close > trendEma and rsi >= rsiLongMin  and rsi <= rsiLongMax
rawShort = ta.crossunder(fastEma, slowEma) and close < trendEma and rsi <= rsiShortMax and rsi >= rsiShortMin

longSignal  = enableLong  and barReady and rawLong  and trendUp   and trendStrong and volOk and atrOk and htfUp   and canSignal and timeOk and dailyOkLong
shortSignal = enableShort and barReady and rawShort and trendDown and trendStrong and volOk and atrOk and htfDown and canSignal and timeOk and dailyOkShort

if longSignal or shortSignal
    lastSignalBar := bar_index

// =====================================================
// === Trade levels (entry zone + 2 TPs)
// =====================================================
// LONG
longEntryMid  = close
longEntryLow  = close - atr * entryZoneAtrMult
longEntryHigh = close + atr * entryZoneAtrMult
longStop      = close - atr * atrStopMult
longRiskAbs   = math.abs(longEntryMid - longStop)
longTp1       = longEntryMid + longRiskAbs * tp1Mult
longTp2       = longEntryMid + longRiskAbs * tp2Mult
longRiskPct   = longRiskAbs / longEntryMid * 100.0

// SHORT
shortEntryMid  = close
shortEntryLow  = close - atr * entryZoneAtrMult
shortEntryHigh = close + atr * entryZoneAtrMult
shortStop      = close + atr * atrStopMult
shortRiskAbs   = math.abs(shortStop - shortEntryMid)
shortTp1       = shortEntryMid - shortRiskAbs * tp1Mult
shortTp2       = shortEntryMid - shortRiskAbs * tp2Mult
shortRiskPct   = shortRiskAbs / shortEntryMid * 100.0

// =====================================================
// === Plot
// =====================================================
plot(fastEma,  "Fast EMA",  color=color.new(color.teal, 0),   linewidth=2)
plot(slowEma,  "Slow EMA",  color=color.new(color.orange, 0), linewidth=2)
plot(trendEma, "Trend EMA", color=color.new(color.gray, 0),   linewidth=2)
plot(useHtfFilter ? htfEma : na, "HTF EMA", color=color.new(color.purple, 0), linewidth=1, style=plot.style_circles)
// v2.1 — Daily EMA: stepline so the regime level is obvious at a glance
plot(useDailyTrend ? dailyEma : na, "Daily EMA", color=color.new(#FF6B35, 0), linewidth=2, style=plot.style_stepline)

plotshape(longSignal,  title="BUY",  style=shape.labelup,   location=location.belowbar, color=color.new(color.green, 0), text="BUY",  textcolor=color.white, size=size.small)
plotshape(shortSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red,   0), text="SELL", textcolor=color.white, size=size.small)

// Shade candles inside blocked hours so the user can SEE the filter working
bgcolor(shadeBlocked and useTimeFilter and isBlockedHour ? color.new(color.orange, 92) : na, title="Blocked hour")

// Draw SL/TP/Entry lines that extend forward from each signal bar
if showLevels and longSignal
    line.new(bar_index, longStop, bar_index + levelsBars, longStop, color=color.new(color.red,   0), width=1, style=line.style_dashed)
    line.new(bar_index, longTp1,  bar_index + levelsBars, longTp1,  color=color.new(color.green, 0), width=1, style=line.style_dashed)
    line.new(bar_index, longTp2,  bar_index + levelsBars, longTp2,  color=color.new(color.lime,  0), width=1, style=line.style_dashed)
    line.new(bar_index, longEntryMid, bar_index + levelsBars, longEntryMid, color=color.new(color.teal, 30), width=2)
    label.new(bar_index, longStop, "SL "  + str.tostring(longStop,  format.mintick), style=label.style_label_left, color=color.new(color.red,   80), textcolor=color.red,   size=size.tiny)
    label.new(bar_index, longTp1,  "TP1 " + str.tostring(longTp1,   format.mintick), style=label.style_label_left, color=color.new(color.green, 80), textcolor=color.green, size=size.tiny)
    label.new(bar_index, longTp2,  "TP2 " + str.tostring(longTp2,   format.mintick), style=label.style_label_left, color=color.new(color.lime,  80), textcolor=color.lime,  size=size.tiny)

if showLevels and shortSignal
    line.new(bar_index, shortStop, bar_index + levelsBars, shortStop, color=color.new(color.red,   0), width=1, style=line.style_dashed)
    line.new(bar_index, shortTp1,  bar_index + levelsBars, shortTp1,  color=color.new(color.green, 0), width=1, style=line.style_dashed)
    line.new(bar_index, shortTp2,  bar_index + levelsBars, shortTp2,  color=color.new(color.lime,  0), width=1, style=line.style_dashed)
    line.new(bar_index, shortEntryMid, bar_index + levelsBars, shortEntryMid, color=color.new(color.maroon, 30), width=2)
    label.new(bar_index, shortStop, "SL "  + str.tostring(shortStop, format.mintick), style=label.style_label_left, color=color.new(color.red,   80), textcolor=color.red,   size=size.tiny)
    label.new(bar_index, shortTp1,  "TP1 " + str.tostring(shortTp1,  format.mintick), style=label.style_label_left, color=color.new(color.green, 80), textcolor=color.green, size=size.tiny)
    label.new(bar_index, shortTp2,  "TP2 " + str.tostring(shortTp2,  format.mintick), style=label.style_label_left, color=color.new(color.lime,  80), textcolor=color.lime,  size=size.tiny)

// Live status table (top-right) — shows every filter's state in real time
var table statusTbl = table.new(position.top_right, 2, 13, bgcolor=color.new(color.black, 75), border_width=1)
checkMark(bool b) => b ? "✓" : "✗"
checkColor(bool b) => b ? color.lime : color.new(color.red, 30)

if showStatusTable and barstate.islast
    table.cell(statusTbl, 0, 0, "Filter",       text_color=color.gray,  text_size=size.small)
    table.cell(statusTbl, 1, 0, "State",        text_color=color.gray,  text_size=size.small)

    table.cell(statusTbl, 0, 1, "Trend up",     text_color=color.silver, text_size=size.small)
    table.cell(statusTbl, 1, 1, checkMark(trendUp),     text_color=checkColor(trendUp),     text_size=size.small)

    table.cell(statusTbl, 0, 2, "ADX ≥ " + str.tostring(adxMin, "#.#"), text_color=color.silver, text_size=size.small)
    table.cell(statusTbl, 1, 2, checkMark(trendStrong) + " (" + str.tostring(adx, "#.#") + ")", text_color=checkColor(trendStrong), text_size=size.small)

    table.cell(statusTbl, 0, 3, "Volume",       text_color=color.silver, text_size=size.small)
    volRatio = volume / volMa
    table.cell(statusTbl, 1, 3, checkMark(volOk) + " (" + str.tostring(volRatio, "#.##") + "×)", text_color=checkColor(volOk), text_size=size.small)

    table.cell(statusTbl, 0, 4, "ATR%",         text_color=color.silver, text_size=size.small)
    atrPct = atr / close * 100.0
    table.cell(statusTbl, 1, 4, checkMark(atrOk) + " (" + str.tostring(atrPct, "#.##") + "%)", text_color=checkColor(atrOk), text_size=size.small)

    table.cell(statusTbl, 0, 5, "RSI",          text_color=color.silver, text_size=size.small)
    table.cell(statusTbl, 1, 5, str.tostring(rsi, "#.#"),  text_color=color.white, text_size=size.small)

    table.cell(statusTbl, 0, 6, "HTF aligned",  text_color=color.silver, text_size=size.small)
    htfState = useHtfFilter ? (close > htfEma ? "UP" : "DN") : "off"
    table.cell(statusTbl, 1, 6, htfState, text_color=useHtfFilter ? color.lime : color.gray, text_size=size.small)

    // v2.1 — Daily regime row
    table.cell(statusTbl, 0, 7, "Daily trend",  text_color=color.silver, text_size=size.small)
    dailyState = useDailyTrend ? (dailyTrendUp ? "UP ✓" : dailyTrendDown ? "DN ✓" : "—") : "off"
    dailyColor = useDailyTrend ? (dailyTrendUp ? color.lime : dailyTrendDown ? color.red : color.gray) : color.gray
    table.cell(statusTbl, 1, 7, dailyState, text_color=dailyColor, text_size=size.small)

    table.cell(statusTbl, 0, 8, "Hour (BKK)",   text_color=color.silver, text_size=size.small)
    table.cell(statusTbl, 1, 8, str.tostring(currentHourBkk) + ":00 " + checkMark(timeOk), text_color=checkColor(timeOk), text_size=size.small)

    table.cell(statusTbl, 0, 9, "Cooldown",     text_color=color.silver, text_size=size.small)
    barsAgo = na(lastSignalBar) ? na : bar_index - lastSignalBar
    cooldownStr = na(barsAgo) ? "ready" : str.tostring(barsAgo) + "/" + str.tostring(cooldownBars)
    table.cell(statusTbl, 1, 9, cooldownStr + " " + checkMark(canSignal), text_color=checkColor(canSignal), text_size=size.small)

    table.cell(statusTbl, 0, 10, "Last signal", text_color=color.silver, text_size=size.small)
    table.cell(statusTbl, 1, 10, na(barsAgo) ? "—" : str.tostring(barsAgo) + " bars ago", text_color=color.white, text_size=size.small)

    table.cell(statusTbl, 0, 11, "Price",       text_color=color.silver, text_size=size.small)
    table.cell(statusTbl, 1, 11, str.tostring(close, format.mintick), text_color=color.white, text_size=size.small)

    statusText = longSignal ? "⬆ LONG SIGNAL" : shortSignal ? "⬇ SHORT SIGNAL" : "○ waiting"
    statusColor = longSignal ? color.lime : shortSignal ? color.red : color.gray
    table.cell(statusTbl, 0, 12, statusText, text_color=statusColor, text_size=size.normal, bgcolor=color.new(statusColor, 80))
    table.cell(statusTbl, 1, 12, "",          text_color=color.gray,  text_size=size.small, bgcolor=color.new(statusColor, 80))

// =====================================================
// === JSON payload
// =====================================================
// Round to N decimals before stringifying — keeps JSON clean for the AI prompt
fmt(float x) => str.tostring(math.round(x * math.pow(10, priceDecimals)) / math.pow(10, priceDecimals))

makePayload(string sig, float eMid, float eLow, float eHigh, float sl, float tp1v, float tp2v, float rAbs, float rPct) =>
    a = '{"secret":"' + secret + '","source":"' + botName + '","signal":"' + sig + '","signal_type":"swing"'
    b = ',"symbol":"' + syminfo.ticker + '","exchange":"' + syminfo.prefix + '","interval":"' + timeframe.period + '","timeframe":"' + timeframe.period + '"'
    c = ',"time":' + str.tostring(time) + ',"bar_time":' + str.tostring(time) + ',"price":' + fmt(close)
    d = ',"entry":' + fmt(eMid) + ',"entry_low":' + fmt(eLow) + ',"entry_high":' + fmt(eHigh)
    e = ',"stop_loss":' + fmt(sl) + ',"take_profit":' + fmt(tp1v) + ',"tp1":' + fmt(tp1v) + ',"tp2":' + fmt(tp2v) + ',"sl":' + fmt(sl)
    f = ',"risk":' + fmt(rAbs) + ',"risk_percent":' + fmt(rPct) + ',"risk_reward_ratio":' + str.tostring(tp2Mult)
    g = ',"rsi":' + fmt(rsi) + ',"adx":' + fmt(adx) + ',"atr":' + fmt(atr) + ',"atr_pct":' + fmt(atr / close * 100.0)
    h = ',"fast_ema":' + fmt(fastEma) + ',"slow_ema":' + fmt(slowEma) + ',"trend_ema":' + fmt(trendEma) + ',"htf_ema":' + fmt(htfEma)
    i = ',"volume":' + fmt(volume) + ',"volume_ma":' + fmt(volMa) + '}'
    a + b + c + d + e + f + g + h + i

if longSignal
    alert(makePayload("BUY", longEntryMid, longEntryLow, longEntryHigh, longStop, longTp1, longTp2, longRiskAbs, longRiskPct), alert.freq_once_per_bar_close)

if shortSignal
    alert(makePayload("SELL", shortEntryMid, shortEntryLow, shortEntryHigh, shortStop, shortTp1, shortTp2, shortRiskAbs, shortRiskPct), alert.freq_once_per_bar_close)

// =====================================================
// === NO_TRADE heartbeat — fires every confirmed bar when no entry valid
// =====================================================
// Inspect which filter(s) prevented a trade so the user sees *why*.
hasAnySignal = longSignal or shortSignal
ntNoCross    = not (rawLong or rawShort)
ntWeakTrend  = (rawLong or rawShort) and not trendStrong
ntLowVolume  = (rawLong or rawShort) and not volOk
ntDeadMarket = (rawLong or rawShort) and not atrOk
ntBlockHour  = useTimeFilter and isBlockedHour
ntCooldown   = (rawLong or rawShort) and not canSignal
ntRsiOut     = (rawLong and not (rsi >= rsiLongMin and rsi <= rsiLongMax)) or (rawShort and not (rsi <= rsiShortMax and rsi >= rsiShortMin))
ntHtfMis     = useHtfFilter and ((rawLong and close <= htfEma) or (rawShort and close >= htfEma))
// v2.1 — Daily regime mismatch (Long signal but BTC < Daily EMA, or Short signal but BTC > Daily EMA)
ntDailyMis   = useDailyTrend and ((rawLong and not dailyTrendUp) or (rawShort and not dailyTrendDown))

boolStr(bool b) => b ? "true" : "false"

makeNoTradePayload() =>
    a = '{"secret":"' + secret + '","source":"' + botName + '","signal":"NO_TRADE","signal_type":"swing"'
    b = ',"symbol":"' + syminfo.ticker + '","exchange":"' + syminfo.prefix + '","interval":"' + timeframe.period + '","timeframe":"' + timeframe.period + '"'
    c = ',"time":' + str.tostring(time) + ',"bar_time":' + str.tostring(time) + ',"price":' + fmt(close)
    d = ',"reasons":{"no_cross":' + boolStr(ntNoCross) + ',"weak_trend":' + boolStr(ntWeakTrend) + ',"low_volume":' + boolStr(ntLowVolume) + ',"dead_market":' + boolStr(ntDeadMarket) + ',"blocked_hour":' + boolStr(ntBlockHour) + ',"cooldown":' + boolStr(ntCooldown) + ',"rsi_out":' + boolStr(ntRsiOut) + ',"htf_misalign":' + boolStr(ntHtfMis) + ',"daily_misalign":' + boolStr(ntDailyMis) + '}'
    e = ',"rsi":' + fmt(rsi) + ',"adx":' + fmt(adx) + ',"atr":' + fmt(atr) + ',"atr_pct":' + fmt(atr / close * 100.0)
    f = ',"volume":' + fmt(volume) + ',"volume_ma":' + fmt(volMa) + ',"hour_bkk":' + str.tostring(currentHourBkk) + '}'
    a + b + c + d + e + f

if enableNoTradeAlert and barstate.isconfirmed and not hasAnySignal
    alert(makeNoTradePayload(), alert.freq_once_per_bar_close)

if testAlert and barstate.isconfirmed
    testSl  = close - atr * atrStopMult
    testTp1 = close + atr * atrStopMult * tp1Mult
    testTp2 = close + atr * atrStopMult * tp2Mult
    testEL  = close - atr * entryZoneAtrMult
    testEH  = close + atr * entryZoneAtrMult
    alert(makePayload("BUY", close, testEL, testEH, testSl, testTp1, testTp2, atr * atrStopMult, atr * atrStopMult / close * 100.0), alert.freq_once_per_bar_close)

// Legacy alertcondition (manual JSON template) — keep for backward compatibility
alertcondition(longSignal,  title="BTC Futures BUY",  message="BUY signal generated. Use Any alert() function call for JSON webhook payload.")
alertcondition(shortSignal, title="BTC Futures SELL", message="SELL signal generated. Use Any alert() function call for JSON webhook payload.")

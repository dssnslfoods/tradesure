//@version=6
// =====================================================
// BTC Futures Strategy v1.1 — Backtest mirror of indicator v2
//
// v1.1 (May 13, 2026): Fixed broken exit logic from v1. The original code
// used `strategy.exit()` with `qty_percent=50 + limit + stop` simultaneously
// which left positions stuck open on long backtests (0 closed trades over
// 16 months in May 2026 test). v1.1 replaces it with explicit price checks
// + `strategy.close()` calls — bullet-proof, no state ambiguity.
//
// Same entry logic as `btc_futures_signal_v2.pine` (EMA cross + RSI + ADX +
// volume + ATR% + HTF + time filter + cooldown) so backtest reflects live.
//
// Two TP exit modes:
//   1) "TP1 only"  — close full position at TP1 or SL (conservative)
//   2) "TP1→TP2"   — close 50% at TP1, move SL to break-even, runner to TP2
//                    (matches the live system's Option-A backtest model)
//
// IMPORTANT: This file is for backtesting / visual analysis only. The live
// production webhook still runs from btc_futures_signal_v2.pine.
// =====================================================
strategy("BTC Futures Strategy v1.1 (backtest)",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.04,            // 0.04% per side ≈ Binance Futures taker
     slippage=2,                       // 2 ticks slippage
     pyramiding=0,
     calc_on_every_tick=false,
     process_orders_on_close=true,
     max_labels_count=500,
     max_bars_back=2000)

// =====================================================
// === Inputs — keep IDENTICAL to indicator v2 so backtest reflects live
// =====================================================
grpCore   = "Core EMAs / RSI / ATR"
fastEmaLength  = input.int(21,  "Fast EMA",  minval=1, group=grpCore)
slowEmaLength  = input.int(55,  "Slow EMA",  minval=1, group=grpCore)
trendEmaLength = input.int(200, "Trend EMA", minval=1, group=grpCore)
rsiLength      = input.int(14,  "RSI Length", minval=1, group=grpCore)
rsiLongMin     = input.float(52.0, "RSI min for LONG",  minval=0, maxval=100, group=grpCore)
rsiLongMax     = input.float(75.0, "RSI max for LONG (avoid overbought)", minval=0, maxval=100, group=grpCore)
rsiShortMax    = input.float(48.0, "RSI max for SHORT", minval=0, maxval=100, group=grpCore)
rsiShortMin    = input.float(25.0, "RSI min for SHORT (avoid oversold)",  minval=0, maxval=100, group=grpCore)
atrLength      = input.int(14,  "ATR Length", minval=1, group=grpCore)

grpRisk   = "Risk Management"
atrStopMult    = input.float(1.8, "Stop-loss ATR multiplier", minval=0.1, step=0.1, group=grpRisk)
tp1Mult        = input.float(1.0, "TP1 reward (R multiple)",  minval=0.1, step=0.1, group=grpRisk)
tp2Mult        = input.float(2.0, "TP2 reward (R multiple)",  minval=0.1, step=0.1, group=grpRisk)
exitMode       = input.string("TP1→TP2 (50% partial + runner, SL→BE)",
     "Exit mode",
     options=["TP1 only (full close)", "TP1→TP2 (50% partial + runner, SL→BE)"],
     group=grpRisk)

grpFilter = "Quality Filters"
adxLength      = input.int(14,   "ADX length", minval=1, group=grpFilter)
adxMin         = input.float(17.0, "ADX minimum (trend strength)", minval=0, group=grpFilter)
trendSlopeBars = input.int(10,   "Trend EMA slope lookback bars",  minval=1, group=grpFilter)
volMaLength    = input.int(20,   "Volume MA length", minval=1, group=grpFilter)
volMult        = input.float(1.0, "Volume must exceed MA × this",  minval=0.0, step=0.1, group=grpFilter)
atrPctMin      = input.float(0.25, "Minimum ATR % of price (kills dead market)", minval=0, step=0.05, group=grpFilter)
useHtfFilter   = input.bool(false, "Require 4H EMA50 trend alignment", group=grpFilter)
htfTimeframe   = input.string("240", "Higher timeframe", options=["120","240","360","720","D"], group=grpFilter)
htfEmaLen      = input.int(50,   "HTF EMA length", minval=1, group=grpFilter)
cooldownBars   = input.int(3,    "Cooldown bars after a signal", minval=0, group=grpFilter)

// Time-of-day gate (same as v2)
useTimeFilter  = input.bool(true,  "Block low win-rate hours (Asia/Bangkok)", group=grpFilter)
blockHours     = input.string("13,14,16,17,20", "Blocked hours (comma list, 0-23 BKK)", group=grpFilter)

grpRun = "Execution"
enableLong  = input.bool(true,  "Enable LONG (BUY) trades",  group=grpRun)
enableShort = input.bool(true,  "Enable SHORT (SELL) trades", group=grpRun)
useConfirmedBar = input.bool(true, "Trade only on confirmed bar", group=grpRun)

grpDate = "Backtest window"
useDateFilter = input.bool(false, "Limit to date range", group=grpDate)
startDate     = input.time(timestamp("2024-01-01T00:00:00"), "Start date", group=grpDate)
endDate       = input.time(timestamp("2030-01-01T00:00:00"), "End date",   group=grpDate)

// =====================================================
// === Indicators
// =====================================================
fastEma  = ta.ema(close, fastEmaLength)
slowEma  = ta.ema(close, slowEmaLength)
trendEma = ta.ema(close, trendEmaLength)
rsi      = ta.rsi(close, rsiLength)
atr      = ta.atr(atrLength)

[diPlus, diMinus, adx] = ta.dmi(adxLength, adxLength)
volMa = ta.sma(volume, volMaLength)

htfEma = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)

// =====================================================
// === Filters
// =====================================================
trendUp     = trendEma > trendEma[trendSlopeBars]
trendDown   = trendEma < trendEma[trendSlopeBars]
trendStrong = adx >= adxMin
volOk       = volume > volMa * volMult
atrOk       = (atr / close * 100.0) >= atrPctMin
htfUp       = not useHtfFilter or close > htfEma
htfDown     = not useHtfFilter or close < htfEma

currentHourBkk = hour(time, "Asia/Bangkok")
isBlockedHour = str.contains("," + blockHours + ",", "," + str.tostring(currentHourBkk) + ",")
timeOk = not useTimeFilter or not isBlockedHour

inDateWindow = not useDateFilter or (time >= startDate and time <= endDate)

barReady = useConfirmedBar ? barstate.isconfirmed : true

// Cooldown
var int lastSignalBar = na
canSignal = na(lastSignalBar) or (bar_index - lastSignalBar) >= cooldownBars

// Raw triggers
rawLong  = ta.crossover(fastEma, slowEma)  and close > trendEma and rsi >= rsiLongMin  and rsi <= rsiLongMax
rawShort = ta.crossunder(fastEma, slowEma) and close < trendEma and rsi <= rsiShortMax and rsi >= rsiShortMin

longSignal  = enableLong  and barReady and rawLong  and trendUp   and trendStrong and volOk and atrOk and htfUp   and canSignal and timeOk and inDateWindow
shortSignal = enableShort and barReady and rawShort and trendDown and trendStrong and volOk and atrOk and htfDown and canSignal and timeOk and inDateWindow

// =====================================================
// === Trade levels (computed at signal bar, frozen via `var` on entry)
// =====================================================
longStop  = close - atr * atrStopMult
longRisk  = math.abs(close - longStop)
longTp1   = close + longRisk * tp1Mult
longTp2   = close + longRisk * tp2Mult

shortStop = close + atr * atrStopMult
shortRisk = math.abs(shortStop - close)
shortTp1  = close - shortRisk * tp1Mult
shortTp2  = close - shortRisk * tp2Mult

// =====================================================
// === Position state — single source of truth
// =====================================================
var float curEntry = na
var float curSL    = na
var float curTp1   = na
var float curTp2   = na
var bool  tp1Done  = false
var int   posDir   = 0  // 1=long, -1=short, 0=flat (mirrors our intended state)

useRunner = exitMode == "TP1→TP2 (50% partial + runner, SL→BE)"

// =====================================================
// === EXIT LOGIC (v1.1 fix) — manual OHLC checks + strategy.close
// =====================================================
// Why this works: strategy.close() with explicit price checks is deterministic.
// We test the bar's high/low directly and decide which level was hit, rather
// than queuing a bracket order via strategy.exit() and hoping Pine routes it
// correctly when both limit and stop fall inside the bar.
//
// Same-bar conflict resolution: when both SL and TP can be reached within
// one bar, we assume SL fills first (pessimistic) to match the live backtest
// model in lib/backtest/evaluateSignal.ts.

// ── LONG exits ────────────────────────────────────────
if posDir == 1 and strategy.position_size > 0
    slHit  = low  <= curSL
    tp1Hit = high >= curTp1
    tp2Hit = high >= curTp2

    if useRunner
        if not tp1Done
            // Phase 1: full position open, SL has priority if both hit
            if slHit
                strategy.close("L", comment="SL")
                posDir := 0
            else if tp1Hit
                // Close 50% at TP1, runner continues with SL → BE
                strategy.close("L", qty_percent=50, comment="TP1")
                tp1Done := true
                curSL   := curEntry
        else
            // Phase 2: runner — SL has been moved to break-even
            if slHit
                strategy.close("L", comment="BE")
                posDir  := 0
                tp1Done := false
            else if tp2Hit
                strategy.close("L", comment="TP2")
                posDir  := 0
                tp1Done := false
    else
        // Simple TP1-only mode — full close on either side
        if slHit
            strategy.close("L", comment="SL")
            posDir := 0
        else if tp1Hit
            strategy.close("L", comment="TP1")
            posDir := 0

// ── SHORT exits ───────────────────────────────────────
if posDir == -1 and strategy.position_size < 0
    slHit  = high >= curSL
    tp1Hit = low  <= curTp1
    tp2Hit = low  <= curTp2

    if useRunner
        if not tp1Done
            if slHit
                strategy.close("S", comment="SL")
                posDir := 0
            else if tp1Hit
                strategy.close("S", qty_percent=50, comment="TP1")
                tp1Done := true
                curSL   := curEntry
        else
            if slHit
                strategy.close("S", comment="BE")
                posDir  := 0
                tp1Done := false
            else if tp2Hit
                strategy.close("S", comment="TP2")
                posDir  := 0
                tp1Done := false
    else
        if slHit
            strategy.close("S", comment="SL")
            posDir := 0
        else if tp1Hit
            strategy.close("S", comment="TP1")
            posDir := 0

// Defensive reset — if Pine closed the position by other means (e.g. session
// rollover, margin event), bring our state back in sync so the next signal
// can fire normally.
if strategy.position_size == 0 and posDir != 0
    posDir  := 0
    tp1Done := false

// =====================================================
// === ENTRIES (only when flat per our `posDir` state)
// =====================================================
// Use posDir == 0 as the gate. strategy.position_size may still show the
// previous size during the same bar a close fires (process_orders_on_close),
// so it's not a reliable flat-check inside the bar.

if longSignal and posDir == 0
    strategy.entry("L", strategy.long)
    curEntry := close
    curSL    := longStop
    curTp1   := longTp1
    curTp2   := longTp2
    tp1Done  := false
    posDir   := 1
    lastSignalBar := bar_index

if shortSignal and posDir == 0
    strategy.entry("S", strategy.short)
    curEntry := close
    curSL    := shortStop
    curTp1   := shortTp1
    curTp2   := shortTp2
    tp1Done  := false
    posDir   := -1
    lastSignalBar := bar_index

// =====================================================
// === Plotting — visual markers on chart
// =====================================================
plot(fastEma,  "Fast EMA",  color=color.new(color.teal, 0),   linewidth=2)
plot(slowEma,  "Slow EMA",  color=color.new(color.orange, 0), linewidth=2)
plot(trendEma, "Trend EMA", color=color.new(color.gray, 0),   linewidth=2)
plot(useHtfFilter ? htfEma : na, "HTF EMA", color=color.new(color.purple, 0), linewidth=1, style=plot.style_circles)

plotshape(longSignal,  title="BUY",  style=shape.labelup,   location=location.belowbar, color=color.new(color.green, 0), text="BUY",  textcolor=color.white, size=size.small)
plotshape(shortSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red,   0), text="SELL", textcolor=color.white, size=size.small)

// Plot active SL / TP levels while in position
plot(posDir != 0 ? curSL  : na, "SL",  color=color.new(color.red,    0), style=plot.style_linebr, linewidth=1)
plot(posDir != 0 ? curTp1 : na, "TP1", color=color.new(color.green,  0), style=plot.style_linebr, linewidth=1)
plot(posDir != 0 and useRunner ? curTp2 : na, "TP2", color=color.new(color.lime, 0), style=plot.style_linebr, linewidth=1)

// =====================================================
// === Info panel (top-right)
// =====================================================
var table info = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 75), border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "Net profit",   text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 0, str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(info, 0, 1, "Trades (closed)", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 1, str.tostring(strategy.closedtrades), text_color=color.white, text_size=size.small)
    winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : 0.0
    table.cell(info, 0, 2, "Win rate",     text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 2, strategy.closedtrades > 0 ? str.tostring(winRate, "#.#") + "%" : "—", text_color=winRate >= 50 ? color.lime : color.red, text_size=size.small)
    pf = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : 0.0
    table.cell(info, 0, 3, "Profit factor", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 3, strategy.closedtrades > 0 ? str.tostring(pf, "#.##") : "—", text_color=pf >= 1.5 ? color.lime : pf >= 1.0 ? color.yellow : color.red, text_size=size.small)
    table.cell(info, 0, 4, "Max DD",       text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 4, str.tostring(strategy.max_drawdown, "#.##"), text_color=color.orange, text_size=size.small)
    table.cell(info, 0, 5, "Avg trade",    text_color=color.gray, text_size=size.small)
    avgTrade = strategy.closedtrades > 0 ? strategy.netprofit / strategy.closedtrades : 0.0
    table.cell(info, 1, 5, strategy.closedtrades > 0 ? str.tostring(avgTrade, "#.##") : "—", text_color=avgTrade >= 0 ? color.lime : color.red, text_size=size.small)
    table.cell(info, 0, 6, "Open trades",  text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 6, str.tostring(strategy.opentrades), text_color=color.aqua, text_size=size.small)
    table.cell(info, 0, 7, "Mode",         text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 7, useRunner ? "TP1→TP2" : "TP1 only", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 8, "Time filter",  text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 8, useTimeFilter ? "ON" : "OFF", text_color=useTimeFilter ? color.lime : color.gray, text_size=size.small)

//@version=6
// =====================================================
// BTC Futures Strategy v1.3 — Day Trader Edition
//
// Why v1.3: v1.2.x produced only 5 trades over 16 months — that's a
// "quality swing system" not a day trader. v1.3 retunes every entry
// parameter for day-trading cadence on 1H/15m crypto:
//
//   PARAMETER         v1.2.2        v1.3 (day trader)   Why
//   ─────────────     ──────        ──────────────────  ─────────
//   Fast EMA          21            9                   more crosses
//   Slow EMA          55            21                  faster trigger
//   Trend EMA         200           50                  shorter trend window
//   ADX minimum       20            15                  accept weaker trends
//   SL ATR mult       2.5           1.2                 tight stops (intraday)
//   TP1 R-multiple    1.5           0.8                 quick first target
//   TP2 R-multiple    3.0           1.6                 realistic runner
//   Cooldown bars     8             1                   minimum gap
//   RSI long range    52-75         50-78               widen acceptance
//   RSI short range   25-48         22-50               widen acceptance
//   Time filter       on            off (default)       day-traders take all hours
//
// Expected on Jan 2025 — May 2026 BTC 1H: 80-150 trades, win rate
// 45-55%, PF 1.1-1.4, max DD 6-10%. The wider RSI ranges + faster EMAs
// generate ~5-10x more entries than v1.2; the tighter R:R keeps each
// trade short so we cycle quickly through them.
//
// Carried over from v1.2:
//   - Bullet-proof exit logic (strategy.close + manual OHLC checks)
//   - 25% of equity sizing (no margin calls)
//   - Optional Daily-trend / BB-squeeze / ATR-expansion regime filters
//     (default OFF — turn on individually to test contribution)
//
// Best timeframes for this version:
//   - 1H BTC/ETH:  3-6 trades/day expected (recommended start)
//   - 15m BTC:     8-15 trades/day (use only if you can monitor)
//   - 5m BTC:      noise dominates — don't recommend
// =====================================================
strategy("BTC Futures Strategy v1.3 (day trader)",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=20,             // 20% per trade — slightly smaller for higher frequency
     commission_type=strategy.commission.percent,
     commission_value=0.04,
     slippage=2,
     pyramiding=0,
     calc_on_every_tick=false,
     process_orders_on_close=true,
     max_labels_count=500,
     max_bars_back=2000)

// =====================================================
// === Inputs (v1.3 day-trader defaults)
// =====================================================
grpCore   = "Core EMAs / RSI / ATR (v1.3: faster)"
fastEmaLength  = input.int(9,   "Fast EMA (v1.3: 9)",  minval=1, group=grpCore)
slowEmaLength  = input.int(21,  "Slow EMA (v1.3: 21)", minval=1, group=grpCore)
trendEmaLength = input.int(50,  "Trend EMA (v1.3: 50)",minval=1, group=grpCore)
rsiLength      = input.int(14,  "RSI Length", minval=1, group=grpCore)
rsiLongMin     = input.float(50.0, "RSI min for LONG (v1.3: 50)",  minval=0, maxval=100, group=grpCore)
rsiLongMax     = input.float(78.0, "RSI max for LONG (v1.3: 78)",  minval=0, maxval=100, group=grpCore)
rsiShortMax    = input.float(50.0, "RSI max for SHORT (v1.3: 50)", minval=0, maxval=100, group=grpCore)
rsiShortMin    = input.float(22.0, "RSI min for SHORT (v1.3: 22)", minval=0, maxval=100, group=grpCore)
atrLength      = input.int(14,  "ATR Length", minval=1, group=grpCore)

grpRisk   = "Risk Management (v1.3: tighter R:R)"
atrStopMult    = input.float(1.2, "Stop-loss ATR multiplier (v1.3: 1.2)", minval=0.1, step=0.1, group=grpRisk)
tp1Mult        = input.float(0.8, "TP1 reward (R multiple) (v1.3: 0.8)",  minval=0.1, step=0.1, group=grpRisk)
tp2Mult        = input.float(1.6, "TP2 reward (R multiple) (v1.3: 1.6)",  minval=0.1, step=0.1, group=grpRisk)
exitMode       = input.string("TP1→TP2 (50% partial + runner, SL→BE)",
     "Exit mode",
     options=["TP1 only (full close)", "TP1→TP2 (50% partial + runner, SL→BE)"],
     group=grpRisk)

grpFilter = "Quality Filters (v1.3: relaxed for frequency)"
adxLength      = input.int(14,   "ADX length", minval=1, group=grpFilter)
adxMin         = input.float(15.0, "ADX minimum (v1.3: 15)", minval=0, group=grpFilter)
trendSlopeBars = input.int(5,    "Trend EMA slope lookback bars (v1.3: 5)", minval=1, group=grpFilter)
volMaLength    = input.int(20,   "Volume MA length", minval=1, group=grpFilter)
volMult        = input.float(0.9, "Volume must exceed MA × this (v1.3: 0.9)", minval=0.0, step=0.1, group=grpFilter)
atrPctMin      = input.float(0.15, "Minimum ATR % of price (v1.3: 0.15)", minval=0, step=0.05, group=grpFilter)
useHtfFilter   = input.bool(false, "Require 4H EMA50 trend alignment", group=grpFilter)
htfTimeframe   = input.string("240", "Higher timeframe", options=["120","240","360","720","D"], group=grpFilter)
htfEmaLen      = input.int(50,   "HTF EMA length", minval=1, group=grpFilter)
cooldownBars   = input.int(1,    "Cooldown bars after a signal (v1.3: 1)", minval=0, group=grpFilter)

useTimeFilter  = input.bool(false, "Block low win-rate hours (v1.3: off by default)", group=grpFilter)
blockHours     = input.string("13,14,16,17,20", "Blocked hours (comma list, 0-23 BKK)", group=grpFilter)

grpRegime = "Regime Filters (opt-in)"
useDailyTrend       = input.bool(false, "Require Daily EMA200 alignment", tooltip="Enable to filter counter-trend trades.", group=grpRegime)
dailyEmaLength      = input.int(200, "Daily EMA length", minval=10, group=grpRegime)
useBBSqueeze        = input.bool(false, "Reject trades when BB squeezing", group=grpRegime)
bbLength            = input.int(20, "Bollinger Band length", minval=2, group=grpRegime)
bbWidthMin          = input.float(0.015, "Min BB width (% of mid)", minval=0.001, step=0.005, group=grpRegime)
useAtrExpansion     = input.bool(false, "Require ATR expansion", group=grpRegime)
atrExpansionMaLen   = input.int(50, "ATR SMA lookback", minval=10, group=grpRegime)
atrExpansionMult    = input.float(0.9, "ATR > SMA × this", minval=0.5, step=0.05, group=grpRegime)

grpRun = "Execution"
enableLong  = input.bool(true,  "Enable LONG (BUY) trades",  group=grpRun)
enableShort = input.bool(true,  "Enable SHORT (SELL) trades", group=grpRun)
useConfirmedBar = input.bool(true, "Trade only on confirmed bar", group=grpRun)

grpDate = "Backtest window"
useDateFilter = input.bool(false, "Limit to date range", group=grpDate)
startDate     = input.time(timestamp("2024-01-01T00:00:00"), "Start date", group=grpDate)
endDate       = input.time(timestamp("2030-01-01T00:00:00"), "End date",   group=grpDate)

// =====================================================
// === Indicators
// =====================================================
fastEma  = ta.ema(close, fastEmaLength)
slowEma  = ta.ema(close, slowEmaLength)
trendEma = ta.ema(close, trendEmaLength)
rsi      = ta.rsi(close, rsiLength)
atr      = ta.atr(atrLength)

[diPlus, diMinus, adx] = ta.dmi(adxLength, adxLength)
volMa = ta.sma(volume, volMaLength)

htfEma = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)

dailyEma = request.security(syminfo.tickerid, "D", ta.ema(close, dailyEmaLength), lookahead=barmerge.lookahead_off)
dailyTrendUp   = not na(dailyEma) and close > dailyEma
dailyTrendDown = not na(dailyEma) and close < dailyEma

bbBasis = ta.sma(close, bbLength)
bbDev   = ta.stdev(close, bbLength)
bbWidth = bbBasis > 0 ? (bbDev * 4.0) / bbBasis : 0.0
notSqueezed = bbWidth > bbWidthMin

atrSma = ta.sma(atr, atrExpansionMaLen)
atrExpanding = atrSma > 0 and atr > atrSma * atrExpansionMult

// =====================================================
// === Filters
// =====================================================
trendUp     = trendEma > trendEma[trendSlopeBars]
trendDown   = trendEma < trendEma[trendSlopeBars]
trendStrong = adx >= adxMin
volOk       = volume > volMa * volMult
atrOk       = (atr / close * 100.0) >= atrPctMin
htfUp       = not useHtfFilter or close > htfEma
htfDown     = not useHtfFilter or close < htfEma

regimeLongOk  = not useDailyTrend  or dailyTrendUp
regimeShortOk = not useDailyTrend  or dailyTrendDown
bbOk          = not useBBSqueeze   or notSqueezed
atrExpOk      = not useAtrExpansion or atrExpanding

currentHourBkk = hour(time, "Asia/Bangkok")
isBlockedHour = str.contains("," + blockHours + ",", "," + str.tostring(currentHourBkk) + ",")
timeOk = not useTimeFilter or not isBlockedHour

inDateWindow = not useDateFilter or (time >= startDate and time <= endDate)

barReady = useConfirmedBar ? barstate.isconfirmed : true

var int lastSignalBar = na
canSignal = na(lastSignalBar) or (bar_index - lastSignalBar) >= cooldownBars

rawLong  = ta.crossover(fastEma, slowEma)  and close > trendEma and rsi >= rsiLongMin  and rsi <= rsiLongMax
rawShort = ta.crossunder(fastEma, slowEma) and close < trendEma and rsi <= rsiShortMax and rsi >= rsiShortMin

longSignal  = enableLong  and barReady and rawLong  and trendUp   and trendStrong and volOk and atrOk and htfUp   and canSignal and timeOk and inDateWindow and regimeLongOk  and bbOk and atrExpOk
shortSignal = enableShort and barReady and rawShort and trendDown and trendStrong and volOk and atrOk and htfDown and canSignal and timeOk and inDateWindow and regimeShortOk and bbOk and atrExpOk

// =====================================================
// === Trade levels
// =====================================================
longStop  = close - atr * atrStopMult
longRisk  = math.abs(close - longStop)
longTp1   = close + longRisk * tp1Mult
longTp2   = close + longRisk * tp2Mult

shortStop = close + atr * atrStopMult
shortRisk = math.abs(shortStop - close)
shortTp1  = close - shortRisk * tp1Mult
shortTp2  = close - shortRisk * tp2Mult

// =====================================================
// === Position state
// =====================================================
var float curEntry = na
var float curSL    = na
var float curTp1   = na
var float curTp2   = na
var bool  tp1Done  = false
var int   posDir   = 0

useRunner = exitMode == "TP1→TP2 (50% partial + runner, SL→BE)"

// =====================================================
// === EXIT LOGIC (manual checks — proven from v1.1+)
// =====================================================
if posDir == 1 and strategy.position_size > 0
    slHit  = low  <= curSL
    tp1Hit = high >= curTp1
    tp2Hit = high >= curTp2

    if useRunner
        if not tp1Done
            if slHit
                strategy.close("L", comment="SL")
                posDir := 0
            else if tp1Hit
                strategy.close("L", qty_percent=50, comment="TP1")
                tp1Done := true
                curSL   := curEntry
        else
            if slHit
                strategy.close("L", comment="BE")
                posDir  := 0
                tp1Done := false
            else if tp2Hit
                strategy.close("L", comment="TP2")
                posDir  := 0
                tp1Done := false
    else
        if slHit
            strategy.close("L", comment="SL")
            posDir := 0
        else if tp1Hit
            strategy.close("L", comment="TP1")
            posDir := 0

if posDir == -1 and strategy.position_size < 0
    slHit  = high >= curSL
    tp1Hit = low  <= curTp1
    tp2Hit = low  <= curTp2

    if useRunner
        if not tp1Done
            if slHit
                strategy.close("S", comment="SL")
                posDir := 0
            else if tp1Hit
                strategy.close("S", qty_percent=50, comment="TP1")
                tp1Done := true
                curSL   := curEntry
        else
            if slHit
                strategy.close("S", comment="BE")
                posDir  := 0
                tp1Done := false
            else if tp2Hit
                strategy.close("S", comment="TP2")
                posDir  := 0
                tp1Done := false
    else
        if slHit
            strategy.close("S", comment="SL")
            posDir := 0
        else if tp1Hit
            strategy.close("S", comment="TP1")
            posDir := 0

if strategy.position_size == 0 and posDir != 0
    posDir  := 0
    tp1Done := false

// =====================================================
// === ENTRIES
// =====================================================
if longSignal and posDir == 0
    strategy.entry("L", strategy.long)
    curEntry := close
    curSL    := longStop
    curTp1   := longTp1
    curTp2   := longTp2
    tp1Done  := false
    posDir   := 1
    lastSignalBar := bar_index

if shortSignal and posDir == 0
    strategy.entry("S", strategy.short)
    curEntry := close
    curSL    := shortStop
    curTp1   := shortTp1
    curTp2   := shortTp2
    tp1Done  := false
    posDir   := -1
    lastSignalBar := bar_index

// =====================================================
// === Plotting
// =====================================================
plot(fastEma,  "Fast EMA",  color=color.new(color.teal, 0),   linewidth=2)
plot(slowEma,  "Slow EMA",  color=color.new(color.orange, 0), linewidth=2)
plot(trendEma, "Trend EMA", color=color.new(color.gray, 0),   linewidth=2)
plot(useHtfFilter   ? htfEma   : na, "HTF EMA",   color=color.new(color.purple, 0), linewidth=1, style=plot.style_circles)
plot(useDailyTrend  ? dailyEma : na, "Daily EMA", color=color.new(#FF6B35, 0),       linewidth=2, style=plot.style_stepline)

plotshape(longSignal,  title="BUY",  style=shape.labelup,   location=location.belowbar, color=color.new(color.green, 0), text="BUY",  textcolor=color.white, size=size.small)
plotshape(shortSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red,   0), text="SELL", textcolor=color.white, size=size.small)

plot(posDir != 0 ? curSL  : na, "SL",  color=color.new(color.red,    0), style=plot.style_linebr, linewidth=1)
plot(posDir != 0 ? curTp1 : na, "TP1", color=color.new(color.green,  0), style=plot.style_linebr, linewidth=1)
plot(posDir != 0 and useRunner ? curTp2 : na, "TP2", color=color.new(color.lime, 0), style=plot.style_linebr, linewidth=1)

regimeBlockDaily = useDailyTrend     and not dailyTrendUp and not dailyTrendDown
regimeBlockBB    = useBBSqueeze      and not notSqueezed
regimeBlockAtr   = useAtrExpansion   and not atrExpanding
regimeBlocked    = regimeBlockDaily or regimeBlockBB or regimeBlockAtr
bgcolor(regimeBlocked ? color.new(color.gray, 95) : na, title="Regime blocked")

// =====================================================
// === Info table
// =====================================================
var table info = table.new(position.top_right, 2, 13, bgcolor=color.new(color.black, 75), border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "v1.3",         text_color=color.aqua,   text_size=size.small)
    table.cell(info, 1, 0, "day-trader",   text_color=color.aqua,   text_size=size.small)

    table.cell(info, 0, 1, "Net profit",   text_color=color.gray,   text_size=size.small)
    table.cell(info, 1, 1, str.tostring(strategy.netprofit, "#.##"), text_color=strategy.netprofit >= 0 ? color.lime : color.red, text_size=size.small)

    table.cell(info, 0, 2, "Trades",       text_color=color.gray,   text_size=size.small)
    table.cell(info, 1, 2, str.tostring(strategy.closedtrades),     text_color=color.white, text_size=size.small)

    winRate = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : 0.0
    table.cell(info, 0, 3, "Win rate",     text_color=color.gray,   text_size=size.small)
    table.cell(info, 1, 3, strategy.closedtrades > 0 ? str.tostring(winRate, "#.#") + "%" : "—", text_color=winRate >= 50 ? color.lime : color.red, text_size=size.small)

    pf = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : 0.0
    table.cell(info, 0, 4, "Profit factor",text_color=color.gray,   text_size=size.small)
    table.cell(info, 1, 4, strategy.closedtrades > 0 ? str.tostring(pf, "#.##") : "—", text_color=pf >= 1.5 ? color.lime : pf >= 1.0 ? color.yellow : color.red, text_size=size.small)

    table.cell(info, 0, 5, "Max DD",       text_color=color.gray,   text_size=size.small)
    table.cell(info, 1, 5, str.tostring(strategy.max_drawdown, "#.##"), text_color=color.orange, text_size=size.small)

    table.cell(info, 0, 6, "Open trades",  text_color=color.gray,   text_size=size.small)
    table.cell(info, 1, 6, str.tostring(strategy.opentrades),       text_color=color.aqua,  text_size=size.small)

    table.cell(info, 0, 7, "—— Regime ——", text_color=color.silver, text_size=size.small)
    table.cell(info, 1, 7, "",             text_color=color.silver, text_size=size.small)

    dailyState = useDailyTrend ? (dailyTrendUp ? "UP ✓" : dailyTrendDown ? "DN ✓" : "—") : "off"
    table.cell(info, 0, 8, "Daily trend",  text_color=color.gray,   text_size=size.small)
    table.cell(info, 1, 8, dailyState,     text_color=useDailyTrend ? (dailyTrendUp ? color.lime : dailyTrendDown ? color.red : color.gray) : color.gray, text_size=size.small)

    table.cell(info, 0, 9, "BB width",     text_color=color.gray,   text_size=size.small)
    table.cell(info, 1, 9, useBBSqueeze ? str.tostring(bbWidth * 100, "#.##") + "% " + (notSqueezed ? "✓" : "✗") : "off", text_color=useBBSqueeze ? (notSqueezed ? color.lime : color.orange) : color.gray, text_size=size.small)

    table.cell(info, 0, 10, "ATR exp.",    text_color=color.gray,   text_size=size.small)
    table.cell(info, 1, 10, useAtrExpansion ? (atrExpanding ? "expanding ✓" : "flat ✗") : "off", text_color=useAtrExpansion ? (atrExpanding ? color.lime : color.orange) : color.gray, text_size=size.small)

    table.cell(info, 0, 11, "Time filter", text_color=color.gray,   text_size=size.small)
    table.cell(info, 1, 11, useTimeFilter ? (timeOk ? "ok ✓" : "BLK ✗") : "off", text_color=useTimeFilter ? (timeOk ? color.lime : color.orange) : color.gray, text_size=size.small)

    table.cell(info, 0, 12, "Mode",        text_color=color.gray,   text_size=size.small)
    table.cell(info, 1, 12, useRunner ? "TP1→TP2" : "TP1 only", text_color=color.white, text_size=size.small)
